#version 450
layout(local_size_x = 16, local_size_y = 16) in;

layout(rgba16f, binding = 0) uniform writeonly image2D outA;
layout(rgba16f, binding = 1) uniform writeonly image2D outB;

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(outA);
    if (p.x >= size.x || p.y >= size.y) return;

    vec2 uv = (vec2(p) + 0.5) / vec2(size);
    float r = length(uv - 0.5);
    float ring = 1.0 - smoothstep(0.0, 0.03, abs(r - 0.25));
    float disc = 1.0 - smoothstep(0.18, 0.20, r);

    imageStore(outA, p, vec4(ring, ring * 0.5, 0.0, 1.0));
    imageStore(outB, p, vec4(0.0, disc, disc, 1.0));
}
