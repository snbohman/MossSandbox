#version 450
layout(local_size_x = 16, local_size_y = 16) in;

layout(rgba16f, binding = 0) uniform writeonly image2D outImage;

layout(push_constant) uniform Push { float time; float width; float height; float frame; } pc;

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(outImage);
    if (p.x >= size.x || p.y >= size.y) return;

    vec2 uv = (vec2(p) + 0.5) / vec2(size);
    float aspect = float(size.x) / float(size.y);
    vec2 g = floor(vec2(uv.x * aspect, uv.y) * 12.0 + pc.time * 0.5);
    float checker = mod(g.x + g.y, 2.0);
    vec3 color = mix(vec3(0.08, 0.08, 0.12), vec3(0.14, 0.14, 0.20), checker);

    imageStore(outImage, p, vec4(color, 1.0));
}
